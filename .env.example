# GymPlanner - valori DIMOSTRATIVI. Copiare in `.env` e sostituire con valori propri.
# Non usare questi valori in produzione. Il file `.env` e' escluso da Git.

# PostgreSQL (usato da compose.yaml e dal backend)
POSTGRES_DB=gymplanner
POSTGRES_USER=gymplanner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connessione del backend (default coerenti con i valori sopra)
DB_URL=jdbc:postgresql://localhost:5432/gymplanner
DB_USERNAME=gymplanner
DB_PASSWORD=change-me

# Primo ADMIN: letto solo se nel database non esiste ancora alcun ADMIN.
# Al primo accesso verra' richiesto il cambio password.
GYM_ADMIN_USERNAME=admin
GYM_ADMIN_EMAIL=admin@example.test
GYM_ADMIN_PASSWORD=change-me-now

# Sicurezza
# true in produzione (HTTPS): il cookie di sessione viene marcato Secure
GYM_COOKIE_SECURE=false
# Origine del frontend ammessa da CORS (solo se servito su un'origine diversa)
GYM_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Fuso usato dal server per le date di calendario (ri-ancoraggio rotazione)
GYM_TIME_ZONE=Europe/Rome
